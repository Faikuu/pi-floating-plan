{
  "name": "@faiku/pi-floating-plan",
  "version": "0.1.0",
  "description": "Pi extension that floats the agent's current plan in a corner of the TUI",
  "author": "Faiku",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "plan",
    "todo",
    "overlay",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faikuu/pi-floating-plan.git"
  },
  "homepage": "https://github.com/Faikuu/pi-floating-plan#readme",
  "bugs": {
    "url": "https://github.com/Faikuu/pi-floating-plan/issues"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22",
    "typebox": "^1.3.27",
    "typescript": "^5"
  }
}
